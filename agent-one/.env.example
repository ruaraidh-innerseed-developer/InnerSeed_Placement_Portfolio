# Agent One Configuration Example
# Copy this to .env and fill in your actual values

# ===== API KEYS =====
# Claude API Key (get from https://console.anthropic.com)
CLAUDE_API_KEY=sk-ant-your-key-here

# OpenAI Whisper API Key (get from https://platform.openai.com)
WHISPER_API_KEY=sk-your-key-here

# Descript API Key (get from https://www.descript.com/api)
DESCRIPT_API_KEY=your-descript-key-here

# Pixabay Music API Key (get from https://pixabay.com/api/)
PIXABAY_API_KEY=your-pixabay-key-here

# ===== GOOGLE DRIVE SETUP =====
# Service Account JSON (from Google Cloud Console)
# This should be a complete JSON string - copy the entire content of your service account JSON file
GOOGLE_DRIVE_OAUTH_JSON='{"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "...", "client_email": "...", "client_id": "...", "auth_uri": "...", "token_uri": "...", "auth_provider_x509_cert_url": "...", "client_x509_cert_url": "..."}'

# Google Drive Folder IDs
# Get these from the URL when you open each folder in Google Drive
# Format: https://drive.google.com/drive/folders/{FOLDER_ID}
AGENT_ONE_INBOX_FOLDER_ID=1abc123def456...
AGENT_ONE_OUTBOX_FOLDER_ID=2ghi789jkl012...
AGENT_ONE_LOGS_FOLDER_ID=3mno345pqr678...
AGENT_ONE_ERRORS_FOLDER_ID=4stu901vwx234...

# ===== AGENT SETTINGS =====
# Processing frequency in minutes (default: 30)
# PROCESSING_SCHEDULE_MINUTES=30

# FFmpeg settings (these have sensible defaults, change only if needed)
# SILENCE_THRESHOLD_DB=-50
# MIN_SILENCE_DURATION=0.5
# AUDIO_NORMALIZATION_DB=-3
# MUSIC_VOLUME_DB=-12

# ===== OPTIONAL =====
# Logging level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Max retries for API calls
# MAX_RETRIES=3
